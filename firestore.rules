rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid; // own doc only
      allow write: if false;                                           // Console only
    }

    // Election metadata and per-location labels (no seal numbers) are readable by any signed-in user.
    // Writes happen only through the importElection Cloud Function (Admin SDK bypasses rules).
    match /elections/{eid} {
      allow read: if signedIn();
      allow write: if false;
      match /locations/{locKey} {
        allow read: if signedIn();
        allow write: if false;
      }
      // Expected seal numbers: never readable or writable from a client.
      match /expected/{locKey} {
        allow read, write: if false;
      }
      // Shared per-stop status every driver sees (see functions/src/stopstatus.js). Drivers may only put a
      // stop on their own truck (or take it over from another driver) and take it off; admins may take any
      // stop off. delivered_* is written only by the functions. Nothing here is custody evidence.
      match /stop_status/{locKey} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['truck_uid', 'truck_name', 'truck_at'])
          && ownTruck();
        allow update: if signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['truck_uid', 'truck_name', 'truck_at'])
          && (ownTruck()
              || (!request.resource.data.keys().hasAny(['truck_uid', 'truck_name', 'truck_at'])
                  && (resource.data.get('truck_uid', null) == request.auth.uid || isAdmin())));
        allow delete: if false;
      }
    }
    // The stop is on the signed-in driver's truck, under their own name, stamped now.
    function ownTruck() {
      return request.resource.data.get('truck_uid', null) == request.auth.uid
        && request.resource.data.get('truck_name', null) == request.auth.token.email.split('@')[0]
        && request.resource.data.get('truck_at', null) == request.time;
    }

    // Deliveries are created by submitDelivery and changed only by adminUpdateDelivery /
    // adminSetDeliveryDeleted (Admin SDK bypasses rules). Clients can read (admins) but never write.
    match /deliveries/{deliveryId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;

      // Edit / delete / restore history (written by the functions)
      match /revisions/{revisionId} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    // Audit trail of every seal check (written by verifySeal).
    match /seal_checks/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // "Clear test data" log per election (written by clearTestData). `late` holds practice deliveries
    // that reached the server from a phone's offline queue after the clear and were not recorded.
    match /test_data_clears/{eid} {
      allow read: if isAdmin();
      allow write: if false;
      match /runs/{id} {
        allow read: if isAdmin();
        allow write: if false;
      }
      match /late/{id} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    // Failed-attempt counters (functions only). Admins may delete one to reset a driver.
    match /rate_limits/{id} {
      allow read: if isAdmin();
      allow delete: if isAdmin();
      allow create, update: if false;
    }
  }
}
